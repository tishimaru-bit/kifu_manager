# コピーして .env を作る。Vercel では Production スコープだけに同じ名前の環境変数を設定する。

# Neon の接続文字列（Singapore、Pooled connection。ホスト名に -pooler が含まれるもの）
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# セッション Cookie の署名鍵。32文字以上のランダムな文字列。下の例の値では起動しない。データベースには保存しない。
# 生成: node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
